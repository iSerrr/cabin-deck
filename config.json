{
  "vjoy_device": 1,
  "tap_ms": 80,
  "switch_gap_ms": 150,
  "hold_timeout_s": 10,
  "pages": [
    {
      "label": "DRIVE",
      "grid": {"cols": 4, "rows": 3},
      "buttons": [
        {"id": "cab_deck_btn_001", "label": "LIGHTS", "icon": "💡", "color": "#e3b341", "type": "tap", "indicator": "lights"},
        {"id": "cab_deck_btn_002", "label": "HIGH BEAM", "icon": "🔦", "color": "#4f8fe8", "type": "tap", "indicator": "high_beam"},
        {"id": "cab_deck_btn_003", "label": "LEFT", "icon": "⬅️", "color": "#3fb950", "type": "tap", "indicator": "blinker_left"},
        {"id": "cab_deck_btn_004", "label": "RIGHT", "icon": "➡️", "color": "#3fb950", "type": "tap", "indicator": "blinker_right"},
        {"id": "cab_deck_btn_005", "label": "HAZARD", "icon": "⚠️", "color": "#e8833a", "type": "tap", "indicator": "hazards"},
        {
          "id": "wipers", "label": "WIPERS", "icon": "🌧️", "color": "#5b8fd6", "type": "switch",
          "positions": ["OFF", "1", "2", "3"],
          "forward": "cab_deck_btn_006", "back": "cab_deck_btn_013",
          "indicator": "wipers"
        },
        {"id": "cab_deck_btn_007", "label": "HORN", "icon": "📯", "color": "#c9a227", "type": "hold"},
        {"id": "cab_deck_btn_008", "label": "ENGINE", "icon": "🔑", "color": "#5b8fd6", "type": "tap", "indicator": "engine"},
        {"id": "cab_deck_btn_009", "label": "PARK BRAKE", "icon": "🅿️", "color": "#e3b341", "type": "tap", "indicator": "park_brake"},
        {"id": "cab_deck_btn_010", "label": "TRAILER AIR", "icon": "🔗", "color": "#d65b5b", "type": "tap", "indicator": "trailer"},
        {"id": "cab_deck_btn_023", "label": "ACTIVATE", "icon": "⏎", "color": "#e8833a", "type": "tap"}
      ]
    },
    {
      "label": "AIR & BRAKES",
      "grid": {"cols": 3, "rows": 2},
      "buttons": [
        {"id": "air", "label": "AIR PRESSURE", "icon": "🌀", "color": "#8b949e", "type": "gauge", "indicator": "air_pressure", "min": 0, "max": 150},
        {
          "id": "retarder", "label": "RETARDER", "icon": "🛑", "color": "#d65b5b", "type": "switch",
          "positions": ["OFF", "1", "2", "3", "4", "5"],
          "forward": "cab_deck_btn_018", "back": "cab_deck_btn_019",
          "indicator": "retarder", "position_source": "retarder"
        },
        {"id": "cab_deck_btn_014", "label": "ENGINE BRAKE", "icon": "⛰️", "color": "#e8833a", "type": "tap", "indicator": "engine_brake"},
        {"id": "cab_deck_btn_015", "label": "DIFF LOCK", "icon": "⚙️", "color": "#e3b341", "type": "tap", "indicator": "diff_lock"},
        {"id": "cab_deck_btn_016", "label": "LIFT AXLE", "icon": "⬆️", "color": "#5b8fd6", "type": "tap", "indicator": "lift_axle"},
        {"id": "cab_deck_btn_017", "label": "TRAILER AXLE", "icon": "⏫", "color": "#5b8fd6", "type": "tap", "indicator": "trailer_lift_axle"}
      ]
    },
    {
      "label": "CAB",
      "grid": {"cols": 3, "rows": 2},
      "buttons": [
        {"id": "cab_deck_btn_020", "label": "BEACON", "icon": "🚨", "color": "#e8833a", "type": "tap", "indicator": "beacon"},
        {"id": "cab_deck_btn_021", "label": "AUX FRONT", "icon": "🔆", "color": "#e3b341", "type": "tap", "indicator": "aux_front"},
        {"id": "cab_deck_btn_022", "label": "AUX ROOF", "icon": "☀️", "color": "#e3b341", "type": "tap", "indicator": "aux_roof"},
        {"id": "cab_deck_btn_011", "label": "WINDOW DOWN", "icon": "⏬", "color": "#8b949e", "type": "hold"},
        {"id": "cab_deck_btn_012", "label": "WINDOW UP", "icon": "⏫", "color": "#8b949e", "type": "hold"}
      ]
    }
  ]
}
